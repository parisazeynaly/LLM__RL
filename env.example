# Copy this file to .env and fill in your real key. Never commit the actual
# .env file — only this .env.example template belongs in the repo.

# Required: Groq API key, used by src/llm/clients.py for all
# mutator/target/judge calls. Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: overrides the default local data/checkpoint directory
# (src/config.py falls back to ./data/causal_rl_run/ if unset).
# CAUSAL_RL_DATA_DIR=./data/causal_rl_run/
